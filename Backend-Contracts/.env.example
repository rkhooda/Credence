# Copy values to an ignored environment file or export them in your shell.
# Never commit real credentials.

PRIVATE_KEY=

# Sepolia RPC that serves historical eth_getLogs.
SEPOLIA_RPC_URL=
ADMIN_ADDRESS=
INITIAL_MANAGER_ADDRESS=
INITIAL_AUDITOR_ADDRESS=
INITIAL_ISSUER_ADDRESS=
INITIAL_ISSUER_NAME=
INITIAL_ISSUER_ACCREDITATION=
INITIAL_ISSUER_WEBSITE=

# Etherscan V2 key, used by `npm run contract:verify`.
ETHERSCAN_API_KEY=

# Address to verify, once deployed (set per contract when verifying).
CONTRACT_ADDRESS=

# PRIVATE_KEY is consumed only by the local deployment command. Never commit
# a populated environment file; use a shell secret manager where possible.
